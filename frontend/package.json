{
  "name": "opspilot-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.21.1 <23" },
  "scripts": {
    "dev": "next dev --hostname localhost --port 3000 --experimental-https --experimental-https-key ../.certs/localhost-key.pem --experimental-https-cert ../.certs/localhost.pem",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
