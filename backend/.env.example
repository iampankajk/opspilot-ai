# Use a dedicated local database and role; URL-encode special password characters.
DATABASE_URL=postgresql+psycopg://opspilot_app:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/opspilot_dev
PUBLIC_ORIGIN=https://localhost:3000
# Absolute lifetime in seconds. Existing sessions are never extended by configuration changes.
VISITOR_SESSION_TTL_SECONDS=86400
CURRENT_DATASET_VERSION=synthetic-payments-v0.1
# Optional integration tests: a separate empty, disposable PostgreSQL database.
# TEST_DATABASE_URL=postgresql+psycopg://opspilot_app:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/opspilot_foundation_test
